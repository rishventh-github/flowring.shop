# Copy to .env and set your own values
PORT=3000
ADMIN_PASSWORD=your-secret-admin-password
SESSION_SECRET=your-session-secret-string

# Optional locally: leave unset to use data/flowring.db
# Required on Vercel for persistent admin/blog/account data:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Optional override for local SQLite directory (ignored when TURSO_DATABASE_URL is set)
# DATA_DIR=/absolute/path/to/data

# Contact form emails (defaults to rishenth.ramoshan@gmail.com)
# CONTACT_TO_EMAIL=rishenth.ramoshan@gmail.com
# Optional: Resend for more reliable delivery on Vercel (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM=FlowRing <onboarding@resend.dev>
